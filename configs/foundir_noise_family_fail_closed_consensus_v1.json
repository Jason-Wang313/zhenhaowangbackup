{
  "schema_version": 1,
  "purpose": "fail-closed consensus selector for frozen Noise and Noise+Low-light restoration routes",
  "scope": {
    "allowed_routes": ["noise", "noise+low_light"],
    "official_or_internal_test_allowed": false,
    "evaluation_split": "training-only source-disjoint development",
    "restoration_training": false
  },
  "decision_rule": {
    "accept_when": "dual_accepted AND dual_route == physical_route AND route is allowed",
