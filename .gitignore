# Default-deny backup scope: large/private runtime assets stay local.
*
!.gitignore
!.gitattributes
!agents.md
!SESSION_HANDOFF_2026-08-18.md
!SESSION_HANDOFF_2026-08-21.md
!advisor_vlm_guided_all_in_one_main_route.jpg
!README.md
!requirements-zimage.txt
!/generate_low_light_pilot.py
!/train_flux2_lowlight.py
!/evaluate_flux2_lowlight_split.py
!/predict_qwen_lowlight_fewshot.py
!/train_qwen_lowlight_ordinal_head.py
!/train_qwen_lowlight_ridge_head.py
!lowlight_restoration/
