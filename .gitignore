!configs/
!configs/*.json
!tests/
!tests/*.py
!smoke/
!smoke/**/
!smoke/*.py
!smoke/*.sh
!smoke/*.txt
!smoke/**/*.py
!smoke/**/*.sh
!pytorch_lightning/
