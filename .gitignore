# Default-deny backup scope: large/private runtime assets stay local.
*
!.gitignore
!.gitattributes
!agents.md
!README.md
!/generate_low_light_pilot.py
!smoke/
!smoke/**/
!smoke/*.py
!smoke/*.sh
!smoke/*.txt
!smoke/**/*.py
!smoke/**/*.sh
!smoke/run_gendeg_custom_batch.pyc
!pytorch_lightning/
!pytorch_lightning/*.py
!pytorch_lightning/**/*.py
!manifests/
!manifests/*.csv
!manifests/*.json
!reports/
!reports/qa/
!reports/qa/*.md
!logs/
!logs/project_journal.md
!patches/
!patches/*.patch

# Explicitly excluded even if a parent directory is later whitelisted.
checkpoints/
downloads/
models/
data/
.conda/
.tools/
smoke/**/*.png
smoke/**/*.jpg
third_party/
